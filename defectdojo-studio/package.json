{
  "name": "defectdojo-pro-iac-studio",
  "version": "1.0.0",
  "private": true,
  "description": "DefectDojo Pro IaC Studio - open-source, low-cost DefectDojo Pro alternative generator for AWS GovCloud (CMMC L2 / NIST SP 800-171)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:py && npm run test:ts",
    "test:py": "python3 -I -m unittest discover -s repo-template/tests -t repo-template -v",
    "test:ts": "tsx --test server/tests/*.test.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
